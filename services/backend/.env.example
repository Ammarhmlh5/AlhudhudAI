# Database Configuration (REQUIRED)
# SECURITY: Never commit real credentials to version control
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_username_here
DB_PASSWORD=your_secure_db_password_here
DB_NAME=al_hudhud
DB_SSLMODE=disable  # Use 'require' or 'verify-full' in production

# Server Configuration
PORT=8080
APP_ENV=development

# Redis Configuration (REQUIRED)
# SECURITY: Use a strong password in production
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0

# Connection Pool Configuration
# Max open connections to database (default: 100)
DB_MAX_OPEN_CONNS=100
# Max idle connections in pool (default: 10)
DB_MAX_IDLE_CONNS=10
# Connection max lifetime in seconds (default: 3600 = 1 hour)
DB_CONN_MAX_LIFETIME=3600
# Connection max idle time in seconds (default: 600 = 10 minutes)
DB_CONN_MAX_IDLE_TIME=600

# Rate Limiting
# Requests per minute per tenant (default: 100)
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Batch Processing Configuration
# Number of messages per batch (default: 100)
BATCH_SIZE=100
# Batch processing interval in milliseconds (default: 100)
BATCH_INTERVAL_MS=100
# Enable adaptive batch sizing based on queue pressure (default: true)
ADAPTIVE_BATCH_MODE=true

# Worker Pool Configuration
# Number of concurrent workers for message processing (default: 50)
WORKER_COUNT=50

# WebSocket Configuration
# Buffer size for WebSocket messages (default: 1000)
WS_BUFFER_SIZE=1000
# Heartbeat interval in seconds (default: 30)
WS_HEARTBEAT_INTERVAL=30
# Write wait in seconds (default: 10)
WS_WRITE_WAIT=10
# Pong wait in seconds (default: 60)
WS_PONG_WAIT=60

# Cache TTL Configuration (in seconds)
# Channel cache TTL (default: 300 = 5 minutes)
CHANNEL_CACHE_TTL=300
# Tariff cache TTL (default: 600 = 10 minutes)
TARIFF_CACHE_TTL=600

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY_HOURS=24

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9091
