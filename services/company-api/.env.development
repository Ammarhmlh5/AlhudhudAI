# Server Configuration
PORT=8082
APP_ENV=development

# Database Configuration
# Connect to shared PostgreSQL database with company-specific user
DB_HOST=localhost
DB_PORT=5432
DB_USER=company_api_user
DB_PASSWORD=company_dev_password
DB_NAME=al_hudhud
DB_SSLMODE=disable

# Connection Pool Configuration
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=600

# JWT Configuration
JWT_SECRET=company-dev-secret-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=168h

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5175

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Email Configuration (SMTP)
# For development, you can use a service like Mailtrap or MailHog
# Leave empty to skip email sending in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@company-portal.local

# Company Portal URL
COMPANY_PORTAL_URL=http://localhost:5175
