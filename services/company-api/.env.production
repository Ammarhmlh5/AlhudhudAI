# Server Configuration
PORT=8081
APP_ENV=production

# Database Configuration
# Connect to shared PostgreSQL database with company-specific user
DB_HOST=production-db-host
DB_PORT=5432
DB_USER=company_api_user
DB_PASSWORD=company_production_password_change_me
DB_NAME=al_hudhud
DB_SSLMODE=verify-full

# Connection Pool Configuration
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=600

# JWT Configuration
JWT_SECRET=company-production-secret-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=168h

# CORS Configuration
ALLOWED_ORIGINS=https://company-portal.example.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=300

# Email Configuration (SMTP)
SMTP_HOST=smtp.production-email-provider.com
SMTP_PORT=587
SMTP_USER=production-email-user
SMTP_PASSWORD=production-email-password-change-me
SMTP_FROM_EMAIL=noreply@company-portal.example.com

# Company Portal URL
COMPANY_PORTAL_URL=https://company-portal.example.com
