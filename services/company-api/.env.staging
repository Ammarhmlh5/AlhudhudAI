# Server Configuration
PORT=8081
APP_ENV=staging

# Database Configuration
# Connect to shared PostgreSQL database with company-specific user
DB_HOST=staging-db-host
DB_PORT=5432
DB_USER=company_api_user
DB_PASSWORD=company_staging_password_change_me
DB_NAME=al_hudhud
DB_SSLMODE=require

# Connection Pool Configuration
DB_MAX_OPEN_CONNS=75
DB_MAX_IDLE_CONNS=15
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=600

# JWT Configuration
JWT_SECRET=company-staging-secret-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=168h

# CORS Configuration
ALLOWED_ORIGINS=https://staging-company-portal.example.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=200

# Email Configuration (SMTP)
SMTP_HOST=smtp.staging-email-provider.com
SMTP_PORT=587
SMTP_USER=staging-email-user
SMTP_PASSWORD=staging-email-password-change-me
SMTP_FROM_EMAIL=noreply@staging-company-portal.example.com

# Company Portal URL
COMPANY_PORTAL_URL=https://staging-company-portal.example.com
